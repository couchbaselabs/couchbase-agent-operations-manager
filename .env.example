# Couchbase Agent Operations Manager - local evaluation settings.
#
#   cp .env.example .env
#
# Every value here is a placeholder for a laptop or a throwaway evaluation
# stack. Rotate the demo API keys and the Couchbase password before this
# deployment is reachable by anything you care about. Settings not listed
# here keep the defaults in docker-compose.yml.

# --- LLM providers ---------------------------------------------------------
# Set one or more to call the provider for real. Without a key the provider
# answers cache misses with a clearly-labelled offline stub, so caching and
# the savings dashboard work with no outbound access.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Default LLM policy for every agent - the global policy on LLM Caching ->
# Providers & Policy, where you can also add per-role / per-agent overrides.
# gpt-5.6-luna is ChatGPT's low-cost tier ($0.20/M in, $1.20/M out at list
# price), so a fresh install spends as little as possible.
LLM_CACHE_PROVIDER=openai
LLM_CACHE_MODEL=gpt-5.6-luna
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=3600
LLM_CACHE_SEMANTIC_ENABLED=true
LLM_CACHE_SIMILARITY_THRESHOLD=0.94
LLM_CACHE_MAX_ENTRIES=5000

# Hosted embedding models for Knowledge Base knowledge sets (optional;
# OpenAI and Gemini embeddings reuse the keys above). Local models need none.
VOYAGE_API_KEY=
COHERE_API_KEY=
MISTRAL_API_KEY=
JINA_API_KEY=

# --- Seed agent API keys (demo values - rotate before real use) -------------
# Settings -> Agent Identities issues real, rotatable keys; these three are
# only so the appliance is usable on first boot.
API_KEY_SUPPORT_AGENT=demo-support-agent-9f21
API_KEY_FINANCE_ANALYST=demo-finance-analyst-7e83
API_KEY_ADMIN=demo-admin-4c56
AGENT_KEY_ROTATION_GRACE_SECONDS=3600

# --- Dashboard login -------------------------------------------------------
# The default admin sets its password at first login. AUTH_SECRET_KEY signs
# dashboard sessions; leave it blank to generate one at startup (sessions
# then reset on every restart) or set a long random value to keep them.
DEFAULT_ADMIN_USERNAME=admin
AUTH_SECRET_KEY=
AUTH_SESSION_TTL_HOURS=12

# --- Couchbase (bundled for evaluation; bring your own cluster for prod) ---
COUCHBASE_CONNECTION_STRING=couchbase://couchbase
COUCHBASE_USERNAME=Administrator
COUCHBASE_PASSWORD=CouchbaseDemo123!
COUCHBASE_BUCKET=agent_operations
COUCHBASE_SCOPE=agent_operations
COUCHBASE_CLUSTER_RAMSIZE=2048
COUCHBASE_BUCKET_RAMSIZE=1024
COUCHBASE_INDEX_RAMSIZE=512
COUCHBASE_FTS_RAMSIZE=512
# For an external TLS cluster: couchbases://host, plus a CA file if needed.
COUCHBASE_TLS_VERIFY=true
COUCHBASE_TLS_CA_FILE=

# --- Network ---------------------------------------------------------------
# The stack serves HTTPS with a self-signed certificate by default; see the
# README's TLS section to install a real one. DISABLE_TLS=true for plain HTTP.
UI_HTTPS_PORT=443
DISABLE_TLS=false
CORS_ALLOWED_ORIGINS=

# --- Observability ---------------------------------------------------------
METRICS_ENABLED=true
METRICS_TOKEN=
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_PORT=9090
TRACING_ENABLED=true
TRACE_SAMPLE_RATE=1.0
TRACE_RETENTION_HOURS=72
AUDIT_LOG_RETENTION_HOURS=168
LLM_CACHE_LOG_RETENTION_HOURS=168
