# --- Couchbase target ------------------------------------------------------
# By default this appliance runs its own bundled Couchbase Server container
# and fully provisions it on every startup (cluster init, RAM quotas,
# bucket/scope/collection/index creation - see couchbase-init/init.sh).
#
# To point this appliance at a Couchbase Enterprise server you already run
# and manage yourself instead, set COMPOSE_PROFILES to empty below (so the
# bundled container and its init script never start - they're only safe to
# run against a Couchbase node this appliance owns outright, since init.sh
# reasserts cluster-wide RAM quotas on every run) and point
# COUCHBASE_CONNECTION_STRING/COUCHBASE_SEARCH_HOST at your server instead.
# You'll need to create COUCHBASE_BUCKET and, inside it, COUCHBASE_SCOPE
# yourself first - operations-manager creates every collection, primary
# index, and Search/vector index it needs on its own at startup (the same
# self-healing path an appliance upgrade uses to add a new collection
# without rerunning couchbase-init), but not the bucket or scope
# themselves. See "Using an external Couchbase server" in the README for
# the full walkthrough.
COMPOSE_PROFILES=local-couchbase
COUCHBASE_CONNECTION_STRING=couchbase://couchbase
COUCHBASE_SEARCH_HOST=couchbase
COUCHBASE_USERNAME=Administrator
COUCHBASE_PASSWORD=CouchbaseDemo123!
COUCHBASE_BUCKET=agent_operations
COUCHBASE_SCOPE=agent_operations

APPLIANCE_NAME=Couchbase Agent Operations Manager
API_KEY_SUPPORT_AGENT=demo-support-agent-9f21
API_KEY_FINANCE_ANALYST=demo-finance-analyst-7e83
API_KEY_ADMIN=demo-admin-4c56
# Retention is a capacity setting here, not just a compliance one: one audit
# entry is written per request and Couchbase holds every document's metadata
# in RAM for as long as it exists. Retention x request rate is what decides
# whether the bucket fills up - and a full bucket refuses writes outright.
# Raise this only alongside COUCHBASE_BUCKET_RAMSIZE.
AUDIT_LOG_RETENTION_HOURS=168

# Couchbase RAM quotas in MB, re-applied on every start (see
# couchbase-init/init.sh). Total reserved is CLUSTER + INDEX + FTS.
COUCHBASE_CLUSTER_RAMSIZE=2048
COUCHBASE_INDEX_RAMSIZE=512
COUCHBASE_FTS_RAMSIZE=512
COUCHBASE_BUCKET_RAMSIZE=1024

# Capacity limits. WORKER_THREADS sizes the pool every blocking Couchbase
# call runs in (these are I/O waits, so more threads than cores is the
# point). MAX_CONCURRENT_REQUESTS caps simultaneous in-flight HTTP requests:
# past it the API answers 503 straight away rather than queueing work behind
# a saturated pool until nginx turns the whole dashboard into 504s.
# INSIGHTS_LOOKBACK_ENTRIES is how many audit-log rows the Dashboard and
# Insights pages read on every refresh - the heaviest recurring query here,
# so lower it before raising it.
WORKER_THREADS=32
MAX_CONCURRENT_REQUESTS=64
QUERY_TIMEOUT_SECONDS=30
DASHBOARD_REQUEST_TIMEOUT_SECONDS=55
INSIGHTS_LOOKBACK_ENTRIES=250
HIJACK_SCAN_INTERVAL_MINUTES=5

# Agent run tracing (Traces page). Spans and run summaries are stored in the
# `traces` collection; retention defaults shorter than the audit log because a
# single run can be a dozen spans.
TRACING_ENABLED=true
TRACE_RETENTION_HOURS=72
# Fraction of agent runs to trace (errors are always traced). Lower this for
# sustained high-volume traffic - see TRACE_SAMPLE_RATE in config.py.
TRACE_SAMPLE_RATE=1.0
TRACE_LOOKBACK_RUNS=500

# Evaluation (Evaluations page). A catalog change runs every dataset marked
# run_on_catalog_change - the same trigger that invalidates the LLM cache, for
# the same reason.
EVAL_RUN_ON_CATALOG_CHANGE=true
EVAL_SEED_STARTER_DATASET=true
EVAL_RUN_HISTORY=50

# Knowledge base (Knowledge Base page). Chunk size and overlap in characters;
# the defaults sit inside what the configured embedding model represents well.
KNOWLEDGE_CHUNK_CHARS=1200
KNOWLEDGE_CHUNK_OVERLAP=200
KNOWLEDGE_MAX_UPLOAD_MB=20

# Inbound agent identity. How long a rotated agent key keeps working after its
# replacement is issued - rotation that causes an outage is rotation nobody
# performs. A key believed to be compromised is revoked instead, which takes
# effect on the next request.
AGENT_KEY_ROTATION_GRACE_SECONDS=3600

# Agent memory consolidation (Agent Memory page). The background pass merges
# near-duplicates, scores importance, and rolls finished sessions into a
# summary through this appliance's own completion gateway.
MEMORY_CONSOLIDATION_INTERVAL_MINUTES=60
HIJACK_CHAIN_WINDOW_SECONDS=120

# --- Local dashboard login -----------------------------------------------
# Signs browser session tokens and encrypts the LDAP bind password at rest
# (see operations-manager/app/user_auth.py). start.sh fills this in with a
# random value the first time it creates .env from this file - only set it
# yourself if you're not using start.sh. Changing it logs everyone out and
# makes any already-stored LDAP bind password unreadable (re-save it from
# Settings -> LDAP Authentication afterward).
AUTH_SECRET_KEY=
# How long a browser session stays signed in before the login page reappears.
AUTH_SESSION_TTL_HOURS=12
# Username of the account every fresh install boots with, no password set
# until the first login (see the Login page).
DEFAULT_ADMIN_USERNAME=admin
# Comma-separated list of exact origins allowed to make credentialed
# (cookie-based) cross-origin requests to the API - empty by default,
# which is correct for the bundled stack (the dashboard is always
# same-origin through nginx). See SECURITY_HARDENING.md.
CORS_ALLOWED_ORIGINS=

# --- LLM response caching for agents -----------------------------------
# All three provider keys are optional. A provider with no key still answers
# on a cache miss, from a clearly-labelled offline stub, so the caching
# gateway and its savings dashboard work with no outbound network access.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Bootstrap defaults only - once the appliance has started, the policy is
# edited from the LLM Caching page and stored in Couchbase.
LLM_CACHE_ENABLED=true
LLM_CACHE_PROVIDER=anthropic
LLM_CACHE_MODEL=claude-sonnet-4-5
LLM_CACHE_TTL_SECONDS=3600
LLM_CACHE_MAX_ENTRIES=5000
LLM_CACHE_SEMANTIC_ENABLED=true
LLM_CACHE_SIMILARITY_THRESHOLD=0.94
LLM_CACHE_LOG_RETENTION_HOURS=168
