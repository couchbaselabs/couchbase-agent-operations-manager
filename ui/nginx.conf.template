# Plain HTTP is redirect-only - every request gets sent to HTTPS on the same
# host. Kept (rather than dropped) so an old bookmark/link to this origin
# over http:// still lands somewhere useful instead of just failing to
# connect.
server {
    listen 80;
    server_name _;
    return 301 https://$host$request_uri;
}

# Pooled, kept-alive connections to operations-manager. Without this every
# proxied API request opened a brand-new TCP + TLS connection to uvicorn
# (nginx's default is HTTP/1.0 with Connection: close upstream), and a
# dashboard page fires several API calls per load plus a poll every 15-30s -
# so each one paid a full TLS handshake against a Python server before any
# work started. Reusing connections removes that per-request cost.
upstream operations_manager {
    server ${OPERATIONS_MANAGER_UPSTREAM};
    keepalive 16;
    # Below uvicorn's default 5s keep-alive, so nginx never reuses a
    # connection the app server has already decided to close.
    keepalive_timeout 4s;
}

server {
    listen 443 ssl;
    # Multiplexes the SPA's parallel API calls over one connection instead of
    # the browser's ~6-per-host HTTP/1.1 limit.
    http2 on;
    server_name _;

    # Self-signed by default (baked in at build time - see the Dockerfile)
    # so this container serves HTTPS out of the box with zero
    # configuration. For a real deployment, mount your own certificate over
    # these same two paths - see docker-compose.yml.
    ssl_certificate     /etc/nginx/tls/server.crt;
    ssl_certificate_key /etc/nginx/tls/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    # Modern, AEAD-only cipher list (PCI DSS v4.0 4.2.1 / CIS "strong
    # cryptography" language) - no RC4/3DES/CBC-mode TLS 1.2 suites, no
    # static-RSA key exchange (no forward secrecy). TLS 1.3's own suites
    # aren't controlled by ssl_ciphers at all, so this only constrains the
    # TLS 1.2 side of ssl_protocols above.
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers on;
    # Single instance, no shared ticket-key rotation across replicas -
    # session cache (below) gives resumption without the forward-secrecy
    # tradeoff of long-lived static session ticket keys.
    ssl_session_tickets off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # Don't advertise the exact nginx version in the Server header or on
    # generated error pages (CIS "minimize information disclosure").
    server_tokens off;

    # Security response headers, applied to every response from this
    # server block (CIS Benchmark / PCI DSS 4.0 6.2 / NIST SC-23 secure
    # defaults for a browser-facing app). `always` so they're also sent on
    # non-2xx responses (4xx/5xx pages), not just successful ones.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    # script-src has no 'unsafe-inline': the one script index.html used to
    # inline (theme-flash prevention) now lives at /theme-init.js instead
    # (see ui/public/theme-init.js) specifically so this can stay strict.
    # style-src keeps 'unsafe-inline' because the dashboard sets React
    # inline `style={{...}}` props throughout - tightening that further
    # would mean re-architecting styling app-wide, not a nginx config change.
    #
    # A variable rather than a second literal add_header: the /docs,
    # /redoc and /openapi.json locations below need this same header
    # missing entirely (see the comment there for why), and an
    # add_header inside a location block replaces every inherited one
    # from this level, not just the one it names - restating the other
    # four there to get that would drift from this list over time. An
    # empty $csp makes add_header below omit the header altogether
    # (documented nginx behavior), so those locations only need to
    # override the variable, and everything else here still applies
    # normally through ordinary inheritance.
    set $csp "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'";
    add_header Content-Security-Policy $csp always;

    root /usr/share/nginx/html;
    index index.html;

    # Reverse proxy to the operations-manager API so the SPA only ever needs to
    # know about its own origin - see OPERATIONS_MANAGER_UPSTREAM in
    # docker-compose.yml. This file is processed by nginx's docker
    # entrypoint (envsubst over /etc/nginx/templates/*.template) before the
    # container starts, so the ${...} variables below are resolved at boot,
    # not at build time. (envsubst here is scoped to real environment
    # variables only, so the nginx runtime variables like $host and $scheme
    # elsewhere in this file are left alone.)
    #
    # OPERATIONS_MANAGER_SCHEME defaults to https - operations-manager
    # serves TLS by default too (its own Dockerfile/docker-entrypoint.sh),
    # so this hop is encrypted like everything else. proxy_ssl_verify is
    # off because that's a self-signed certificate by default and this hop
    # stays inside the docker-compose network's private bridge, not the
    # open internet - the goal is opportunistic encryption in transit, not
    # nginx authenticating operations-manager's identity. If you set
    # DISABLE_TLS=true on operations-manager, set OPERATIONS_MANAGER_SCHEME=http
    # here too so this proxy hop keeps matching what it's actually speaking.
    # Knowledge-base uploads: the API accepts documents up to
    # KNOWLEDGE_MAX_UPLOAD_MB (20MB by default, sent base64-encoded so ~27MB
    # on the wire) and parses and embeds them inline, which can take
    # minutes. nginx's defaults (1MB body, 60s read) rejected anything over
    # about 750KB with a 413 and cut off large ones part-way.
    location = /v1/knowledge {
        client_max_body_size 32m;
        proxy_pass ${OPERATIONS_MANAGER_SCHEME}://operations_manager/v1/knowledge;
        proxy_ssl_verify off;
        proxy_ssl_session_reuse on;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 660s;
        proxy_send_timeout 660s;
    }

    location /v1/ {
        proxy_pass ${OPERATIONS_MANAGER_SCHEME}://operations_manager/v1/;
        proxy_ssl_verify off;
        proxy_ssl_session_reuse on;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location /api/ {
        proxy_pass ${OPERATIONS_MANAGER_SCHEME}://operations_manager/api/;
        proxy_ssl_verify off;
        proxy_ssl_session_reuse on;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Stated rather than inherited, so both proxied locations agree and
        # neither drifts if nginx's default changes. The app aims to answer
        # first (DASHBOARD_REQUEST_TIMEOUT_SECONDS, default 55s) - reaching
        # this ceiling instead means the upstream never got far enough to
        # time itself out, which is a different fault worth telling apart.
        proxy_read_timeout 60s;
    }

    # Same-origin API documentation: FastAPI's bundled Swagger UI (/docs)
    # and ReDoc (/redoc), plus the /openapi.json they both read from,
    # proxied straight through from operations-manager so the dashboard
    # can link to "API Documentation" (see Sidebar.tsx) as one of its own
    # paths instead of sending people to a separate
    # https://<host>:8090 origin - handy as-is for docker-compose.yml,
    # where that port is reachable directly, but the Helm chart doesn't
    # expose operations-manager outside the cluster at all, so this proxy
    # is what makes the link work there too.
    #
    # $csp is set to empty in every one of these three locations, which
    # makes the add_header above omit Content-Security-Policy entirely on
    # their responses - the same exclusion operations-manager already
    # applies to these same three paths itself (see main.py's
    # _NO_CSP_PATH_PREFIXES): Swagger UI/ReDoc load their JS/CSS from a
    # CDN, and the strict script-src 'self' set above would just break
    # the docs page, not protect anything (dev/ops tooling, not an
    # attacker-reachable surface any differently than the rest of the
    # API). Every other security header (HSTS, X-Frame-Options - still
    # DENY, since this is a full-page link, never an embed - etc.) is
    # untouched and still applies through ordinary inheritance.
    location /docs {
        set $csp "";
        proxy_pass ${OPERATIONS_MANAGER_SCHEME}://operations_manager/docs;
        proxy_ssl_verify off;
        proxy_ssl_session_reuse on;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location /redoc {
        set $csp "";
        proxy_pass ${OPERATIONS_MANAGER_SCHEME}://operations_manager/redoc;
        proxy_ssl_verify off;
        proxy_ssl_session_reuse on;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location /openapi.json {
        set $csp "";
        proxy_pass ${OPERATIONS_MANAGER_SCHEME}://operations_manager/openapi.json;
        proxy_ssl_verify off;
        proxy_ssl_session_reuse on;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Vite emits content-hashed filenames under /assets/, so a given URL's
    # bytes never change - let the browser keep them for a year instead of
    # re-requesting the ~420KB app bundle on every visit. `expires` (not
    # add_header) so the security headers above are still inherited here.
    # index.html itself stays uncached, so a new build is picked up at once.
    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    location / {
        try_files $uri /index.html;
    }

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_types text/css application/javascript application/json image/svg+xml;
}
